{
  "name": "botspoof",
  "version": "1.0.0",
  "description": "BotSpoof AI Chatbot",
  "type": "module",
  "scripts": {
    "postinstall": "npm run install:all",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend",
    "start": "npm start --prefix backend",
    "dev": "npx concurrently \"npm start --prefix backend\" \"npm run dev --prefix frontend\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1"
  }
}
